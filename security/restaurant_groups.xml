<odoo>
    <record id="group_restaurant_manager" model="res.groups">
        <field name="name">Restaurant Manager</field>
        <field name="comment">
            Full access to restaurant management.
        </field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_restaurant_cashier" model="res.groups">
        <field name="name">Restaurant Cashier</field>
        <field name="comment">
            Manage restaurant orders, payments and reservations.
        </field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_restaurant_kitchen" model="res.groups">
        <field name="name">Restaurant Kitchen</field>
        <field name="comment">
            View orders and update preparation status.
        </field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>