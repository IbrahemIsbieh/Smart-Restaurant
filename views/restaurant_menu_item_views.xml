<odoo>
    <record id="restaurant_menu_item_view_list" model="ir.ui.view">
        <field name="name">restaurant.menu.item.list</field>
        <field name="model">restaurant.menu.item</field>
        <field name="arch" type="xml">
            <list string="Restaurant Menu">
                <field name="name"/>
                <field name="category_id"/>
                <field name="sale_price"/>
                <field name="product_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="restaurant_menu_item_view_form" model="ir.ui.view">
        <field name="name">restaurant.menu.item.form</field>
        <field name="model">restaurant.menu.item</field>
        <field name="arch" type="xml">
            <form string="Menu Item">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="sale_price"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Recipe Ingredients">
                            <field name="recipe_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_menu_item_action" model="ir.actions.act_window">
        <field name="name">Menu Items</field>
        <field name="res_model">restaurant.menu.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>