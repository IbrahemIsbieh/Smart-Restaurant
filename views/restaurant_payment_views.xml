<odoo>
    <record id="restaurant_payment_view_list" model="ir.ui.view">
        <field name="name">restaurant.payment.list</field>
        <field name="model">restaurant.payment</field>
        <field name="arch" type="xml">
            <list string="Restaurant Payments">
                <field name="date"/>
                <field name="order_id"/>
                <field name="payment_method"/>
                <field name="amount"/>
                <field name="reference"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="restaurant_payment_view_form" model="ir.ui.view">
        <field name="name">restaurant.payment.form</field>
        <field name="model">restaurant.payment</field>
        <field name="arch" type="xml">
            <form string="Restaurant Payment">
                <header>
                    <button name="action_post"
                            type="object"
                            string="Post Payment"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state != 'draft'"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted,cancelled"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="order_id"
                                   readonly="state != 'draft'"/>
                            <field name="date"/>
                            <field name="payment_method"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="reference"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_payment_action" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">restaurant.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>