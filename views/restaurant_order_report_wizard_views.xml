<odoo>
    <record id="restaurant_order_report_wizard_view_form" model="ir.ui.view">
        <field name="name">restaurant.order.report.wizard.form</field>
        <field name="model">restaurant.order.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Restaurant Orders Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="order_type"/>
                        <field name="include_cancelled"/>
                    </group>
                </group>
                <footer>
                    <button
                        name="action_view_orders"
                        type="object"
                        string="View Orders"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="restaurant_order_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Orders Report</field>
        <field name="res_model">restaurant.order.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>