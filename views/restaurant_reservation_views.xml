<odoo>
    <record id="restaurant_reservation_view_list" model="ir.ui.view">
        <field name="name">restaurant.reservation.list</field>
        <field name="model">restaurant.reservation</field>
        <field name="arch" type="xml">
            <list string="Restaurant Reservations">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="table_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="guest_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="restaurant_reservation_view_form" model="ir.ui.view">
        <field name="name">restaurant.reservation.form</field>
        <field name="model">restaurant.reservation</field>
        <field name="arch" type="xml">
            <form string="Restaurant Reservation">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm Reservation"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel Reservation"
                            invisible="state not in ['draft', 'confirmed']"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="table_id"/>
                            <field name="guest_count"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_reservation_action" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">restaurant.reservation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>