<odoo>
    <record id="restaurant_category_view_list" model="ir.ui.view">
        <field name="name">restaurant.category.list</field>
        <field name="model">restaurant.category</field>
        <field name="arch" type="xml">
            <list string="Restaurant Categories">
                <field name="name"/>
                <field name="menu_item_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="restaurant_category_view_form" model="ir.ui.view">
        <field name="name">restaurant.category.form</field>
        <field name="model">restaurant.category</field>
        <field name="arch" type="xml">
            <form string="Restaurant Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="menu_item_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Menu Items">
                            <field name="menu_item_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="sale_price"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">restaurant.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>