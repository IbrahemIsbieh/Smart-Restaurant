<odoo>
    <record id="restaurant_recipe_line_view_list" model="ir.ui.view">
        <field name="name">restaurant.recipe.line.list</field>
        <field name="model">restaurant.recipe.line</field>
        <field name="arch" type="xml">
            <list string="Recipe Ingredients">
                <field name="menu_item_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="product_uom_id"/>
            </list>
        </field>
    </record>

    <record id="restaurant_recipe_line_view_form" model="ir.ui.view">
        <field name="name">restaurant.recipe.line.form</field>
        <field name="model">restaurant.recipe.line</field>
        <field name="arch" type="xml">
            <form string="Recipe Ingredient">
                <sheet>
                    <group>
                        <field name="menu_item_id"/>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="product_uom_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_recipe_line_action" model="ir.actions.act_window">
        <field name="name">Recipe Ingredients</field>
        <field name="res_model">restaurant.recipe.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>