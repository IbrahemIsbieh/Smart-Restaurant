<odoo>
    <record id="restaurant_table_view_list" model="ir.ui.view">
        <field name="name">restaurant.table.list</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <list string="Restaurant Tables">
                <field name="name"/>
                <field name="capacity"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="restaurant_table_view_form" model="ir.ui.view">
        <field name="name">restaurant.table.form</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <form string="Restaurant Table">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="capacity"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Reservations">
                            <field name="reservation_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_table_action" model="ir.actions.act_window">
        <field name="name">Tables</field>
        <field name="res_model">restaurant.table</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>